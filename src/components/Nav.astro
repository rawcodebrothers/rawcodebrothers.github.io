---
import Logo from '@/components/Logo.astro';
import NavLink from '@/components/NavLink.astro';
import ScrambleText from '@/components/ScrambleText.astro';
import LocaleSwitch from '@/components/LocaleSwitch.astro';
import { getContent, localePath, site, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = '/' } = Astro.props;
const t = getContent(locale);
---

<header
  class="sticky top-0 z-40 border-b border-border-subtle bg-surface/85 backdrop-blur-md"
>
  <nav
    aria-label={t.ui.primaryNav}
    class="mx-auto flex h-[72px] max-w-6xl items-center justify-between gap-4 px-6"
  >
    <a
      href={localePath(locale)}
      class="shrink-0"
      aria-label={`${site.name}, ${t.ui.home}`}
    >
      <Logo />
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        t.nav.map((link) => (
          <li>
            <NavLink href={link.href} class="nav-label">
              {link.label}
            </NavLink>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <LocaleSwitch locale={locale} path={path} class="hidden md:inline-flex" />

      <a
        href={`mailto:${site.email}`}
        class="hidden items-center gap-2 rounded-full border border-border-strong bg-card px-5 py-2.5 text-[13px] font-medium tracking-wide text-foreground transition-colors duration-200 ease-out-quart hover:bg-elevated md:inline-flex"
      >
        <ScrambleText text={t.ui.contact} />
        <svg
          class="h-3.5 w-3.5 text-muted"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"></path>
        </svg>
      </a>

      <button
        type="button"
        id="menu-toggle"
        aria-controls="menu-mobile"
        aria-expanded="false"
        aria-label={t.ui.openMenu}
        data-label-open={t.ui.openMenu}
        data-label-close={t.ui.closeMenu}
        class="-mr-2 inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-foreground transition-colors duration-200 ease-out-quart hover:bg-elevated md:hidden"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="menu-mobile"
    hidden
    class="border-t border-border-subtle bg-surface px-6 pb-6 pt-2 md:hidden"
  >
    <ul class="flex flex-col">
      {
        t.nav.map((link) => (
          <li>
            <a
              href={link.href}
              class="block border-b border-border-subtle py-4 font-mono text-sm text-muted transition-colors hover:text-foreground"
              data-menu-close
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href={`mailto:${site.email}`}
      class="mt-6 flex items-center justify-center gap-2 rounded-full bg-brand px-5 py-3.5 text-[13px] font-bold tracking-wide text-brand-foreground"
      data-menu-close
    >
      {t.ui.contact}
      <svg
        class="h-3.5 w-3.5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"></path>
      </svg>
    </a>

    <LocaleSwitch locale={locale} path={path} class="mt-4 w-full justify-center" />
  </div>
</header>
