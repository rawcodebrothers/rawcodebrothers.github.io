---
import type { Project } from '@/i18n';

interface Props {
  project: Project;
  statusLabel: string;
  kindLabel: string;
}

const { project, statusLabel, kindLabel } = Astro.props;
const linked = project.href !== undefined;
const Tag = linked ? 'a' : 'div';
const linkProps = linked
  ? { href: project.href, target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<Tag
  {...linkProps}
  class:list={[
    'group card-gradient flex h-full flex-col rounded-2xl border border-border-subtle p-7 transition-colors duration-300',
    linked && 'hover:border-brand/40',
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="font-display text-title font-medium tracking-tight text-foreground">
      {project.name}
    </h3>
    {
      linked && (
        <svg
          class="mt-1 h-4 w-4 shrink-0 text-muted transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-brand"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17 17 7M9 7h8v8" />
        </svg>
      )
    }
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1.5">
    <span class="flex items-center gap-2">
      <span
        class:list={[
          'h-1.5 w-1.5 rounded-full',
          project.live ? 'bg-brand' : 'bg-muted/50',
        ]}
        aria-hidden="true"></span>
      <span class="font-mono text-xs text-muted">{statusLabel}</span>
    </span>
    <span
      class:list={[
        'rounded-full px-2 py-0.5 font-mono text-[11px]',
        project.kind === 'client'
          ? 'bg-brand/15 text-brand'
          : 'bg-elevated text-muted',
      ]}
    >
      {kindLabel}
    </span>
  </div>

  <p class="mt-4 flex-1 text-body text-muted">{project.summary}</p>

  <ul class="mt-6 flex flex-wrap gap-2">
    {
      project.tags.map((tag) => (
        <li class="rounded-full border border-border-strong bg-elevated px-2.5 py-1 font-mono text-xs text-foreground/70">
          {tag}
        </li>
      ))
    }
  </ul>
</Tag>
