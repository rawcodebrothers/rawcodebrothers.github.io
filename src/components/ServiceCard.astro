---
import type { Service } from '@/data/site';

interface Props {
  service: Service;
  index: number;
}

const { service, index } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<article
  class="group card-gradient flex h-full flex-col rounded-2xl border border-border-subtle p-7 transition-colors duration-300 hover:border-border-strong"
>
  <span class="font-mono text-xs text-brand-deep">{number}</span>

  <h3 class="mt-4 font-display text-title font-medium tracking-tight text-foreground">
    {service.name}
  </h3>

  <p class="mt-3 text-body text-muted">{service.summary}</p>

  <ul class="mt-6 flex flex-col gap-2 border-t border-border-subtle pt-5">
    {
      service.bullets.map((bullet) => (
        <li class="flex items-start gap-2.5 text-body text-foreground/75">
          <span class="mt-2 h-px w-3 shrink-0 bg-brand/60" />
          {bullet}
        </li>
      ))
    }
  </ul>
</article>
