---
import { getContent, localePath, otherLocale, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  path?: string;
  class?: string;
}

const { locale, path = '/', class: className } = Astro.props;
const target = otherLocale(locale);
const targetContent = getContent(target);
---

<a
  href={localePath(target, path)}
  hreflang={targetContent.htmlLang}
  lang={targetContent.htmlLang}
  class={`inline-flex items-center gap-1.5 rounded-full border border-border-strong px-3 py-1.5 font-mono text-xs text-muted transition-colors duration-200 ease-out-quart hover:border-brand/40 hover:text-foreground ${className ?? ''}`}
>
  <svg
    class="h-3.5 w-3.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="9"></circle>
    <path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18"></path>
  </svg>
  {targetContent.label}
</a>
