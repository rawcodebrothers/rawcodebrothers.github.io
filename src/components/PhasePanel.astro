---
import { site, type Phase } from '@/i18n';

interface Props {
  phase: Phase;
  usualLabel: string;
  ourLabel: string;
}

const { phase, usualLabel, ourLabel } = Astro.props;
---

<article data-step class="phase-slide">
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <code class="font-mono text-sm text-brand">{phase.call}</code>
    <h3 class="font-display text-title font-medium tracking-tight text-foreground">
      {phase.title}
    </h3>
  </div>

  <div class="phase-cards relative mt-6 border-y border-border-subtle p-2">
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -left-px -top-px size-1.5 bg-brand"></span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -bottom-px -right-px size-1.5 bg-brand"></span>

    <div class="grid gap-2 sm:grid-cols-2">
      <div
        class="group/card relative flex flex-col border border-border-subtle bg-surface px-6 py-6 transition-colors duration-200 ease-out-quart hover:border-border-strong"
      >
        <span
          aria-hidden="true"
          class="pointer-events-none absolute bottom-2 left-2 size-1.5 border-b border-l border-border-strong"
        ></span>
        <div class="flex flex-col items-start gap-3">
          <span
            aria-hidden="true"
            class="h-px w-3 origin-left bg-muted transition-transform duration-300 ease-out-quart group-hover/card:scale-x-[2.5]"
          ></span>
          <p class="eyebrow">{usualLabel}</p>
        </div>
        <p class="mt-3 text-body text-muted">{phase.usual}</p>
      </div>

      <div
        class="group/card card-gradient relative flex flex-col border border-border-subtle px-6 py-6 transition-colors duration-200 ease-out-quart hover:border-brand/40"
      >
        <span
          aria-hidden="true"
          class="pointer-events-none absolute bottom-2 right-2 size-1.5 border-b border-r border-brand/50"
        ></span>
        <div class="flex flex-col items-start gap-3">
          <span
            aria-hidden="true"
            class="h-px w-3 origin-left bg-brand transition-transform duration-300 ease-out-quart group-hover/card:scale-x-[2.5]"
          ></span>
          <p class="eyebrow text-brand">{ourLabel} {site.name}</p>
        </div>
        <p class="mt-3 text-body text-foreground/85">{phase.ours}</p>
      </div>
    </div>
  </div>
</article>

<style is:global>
  .phase-slide {
    padding-block: 2rem;
  }

  .phase-cards {
    opacity: 0;
    transform: translateY(18px) scale(0.985);
    transition:
      opacity 0.5s var(--ease-out-quart),
      transform 0.5s var(--ease-out-quart);
    will-change: opacity, transform;
  }

  [data-step].is-active .phase-cards {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .phase-cards {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
