---
interface Props {
  call: string;
}

const { call } = Astro.props;
---

<div class="mx-auto max-w-6xl px-6" aria-hidden="true">
  <div class="flex items-center gap-4 py-10 sm:py-14">
    <span class="h-px flex-1 bg-border-subtle"></span>
    <code class="font-mono text-[13.5px] text-muted/70">{call}</code>
    <span class="h-px flex-1 bg-border-subtle"></span>
  </div>
</div>
