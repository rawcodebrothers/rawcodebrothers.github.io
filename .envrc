use flake
# Point testcontainers at the rootless podman socket when running under
# podman. Plain Docker installs use /var/run/docker.sock and don't need this.
if [ -S "/run/user/$UID/podman/podman.sock" ] && [ ! -S /var/run/docker.sock ]; then
  export DOCKER_HOST="unix:///run/user/$UID/podman/podman.sock"
fi
