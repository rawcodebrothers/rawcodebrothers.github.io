---
import type { Project } from '@/i18n';

interface Props {
  project: Project;
  statusLabel: string;
}

const { project, statusLabel } = Astro.props;
const live = project.live;
---

<a
  href={project.href}
  target="_blank"
  rel="noopener noreferrer"
  class="group card-gradient flex h-full flex-col rounded-2xl border border-border-subtle p-7 transition-colors duration-300 hover:border-brand/40"
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="font-display text-title font-medium tracking-tight text-foreground">
      {project.name}
    </h3>
    <svg
      class="mt-1 h-4 w-4 shrink-0 text-muted transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-brand"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M7 17 17 7M9 7h8v8" />
    </svg>
  </div>

  <div class="mt-3 flex items-center gap-2">
    <span
      class={`h-1.5 w-1.5 rounded-full ${live ? 'bg-brand' : 'bg-muted/50'}`}
      aria-hidden="true"></span>
    <span class="font-mono text-xs text-muted">{statusLabel}</span>
  </div>

  <p class="mt-4 flex-1 text-body text-muted">{project.summary}</p>

  <ul class="mt-6 flex flex-wrap gap-2">
    {
      project.tags.map((tag) => (
        <li class="rounded-full border border-border-strong bg-elevated px-2.5 py-1 font-mono text-xs text-foreground/70">
          {tag}
        </li>
      ))
    }
  </ul>
</a>
